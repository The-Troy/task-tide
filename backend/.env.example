APP_NAME=TaskTide
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:9002

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (PostgreSQL — local or Supabase)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tasktide
DB_USERNAME=postgres
DB_PASSWORD=

# Broadcasting (Laravel Reverb — run: php artisan reverb:start)
BROADCAST_DRIVER=reverb
REVERB_APP_ID=tasktide
REVERB_APP_KEY=local_reverb_key
REVERB_APP_SECRET=local_reverb_secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Cache / Queue / Session
CACHE_DRIVER=redis
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (use 'log' for local dev — emails appear in storage/logs/laravel.log)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@tasktide.app
MAIL_FROM_NAME="TaskTide"

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
